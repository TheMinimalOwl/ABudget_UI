# ---------------------------------------------------------------------------
# Actual Budget (servidor en el LXC)
# ---------------------------------------------------------------------------
ACTUAL_SERVER_URL=http://192.168.10.48:5006

# Contraseña del servidor Actual (login por contraseña)
ACTUAL_PASSWORD=

# Sync ID del presupuesto: Ajustes -> Avanzado -> Sync ID
# (es el groupId del presupuesto, no el nombre)
ACTUAL_BUDGET_SYNC_ID=

# Contraseña de cifrado E2E del presupuesto.
# Si el presupuesto no está cifrado, dejar vacío.
ACTUAL_BUDGET_PASSWORD=

# ---------------------------------------------------------------------------
# BFF
# ---------------------------------------------------------------------------
DATA_DIR=./.data
PORT=5007
READ_ONLY=true
SYNC_INTERVAL_SECONDS=300
TZ=Europe/Madrid

# Origen permitido de la SPA (CORS/CSRF)
APP_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# Auth de la UI (single user)
# ---------------------------------------------------------------------------
# Hash Argon2id de la contraseña de acceso a la UI.
# Generar con: node scripts/hash-password.mjs "tu-contraseña"
AUTH_PASSWORD_HASH=

# Secreto para firmar cookies de sesión (cadena aleatoria larga)
SESSION_SECRET=
